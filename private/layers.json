        }
    ],
    "welcome_examples": [
        "Is there evidence that coral communities on the Emperor seamounts recover after bottom trawling stops? Quote the strongest passages with paper and page.",
        "Which BBNJ Annex I criteria have the most evidence from the Emperor Seamount Chain, and which papers support the top three?"
    ],
    "collections": [
        {
            "insert_after": "ebsa-2023",
            "collection": {
                "collection_id": "imma",
                "collection_url": "https://s3-west.nrp-nautilus.io/public-high-seas/imma/stac-collection.json",
                "assets": [
                    {
                        "id": "imma-pmtiles",
                        "display_name": "Important Marine Mammal Areas (IUCN-MMPATF)",
                        "group": "Designated Areas",
                        "visible": false,
                        "tooltip_fields": [
                            "title",
                            "criteria",
                            "qualifying_sp",
                            "region",
                            "area_sqkm",
                            "year_classified"
                        ]
                    }
                ]
            }
        },
        {
            "insert_after": "imma",
            "collection": {
                "collection_id": "kba-2026-03-sites",
                "collection_url": "https://s3-west.nrp-nautilus.io/public-kba/kba-2026-03/sites/stac-collection.json",
                "assets": [
                    {
                        "id": "sites-pmtiles",
                        "display_name": "Key Biodiversity Areas, marine and coastal (KBA Partnership)",
                        "group": "Designated Areas",
                        "visible": false,
                        "default_filter": [
                            "match",
                            [
                                "get",
                                "realm"
                            ],
                            [
                                "marine",
                                "coastal"
                            ],
                            true,
                            false
                        ],
                        "tooltip_fields": [
                            "IntName",
                            "Country",
                            "KbaClass",
                            "IbaStatus",
                            "realm",
                            "marine_frac",
                            "AreaKM2"
                        ]
                    }
                ]
            }
        }
    ]
