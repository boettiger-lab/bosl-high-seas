{
    "_comment": "Restricted-licence layers added ONLY to the private deployment (#85). Each entry is inserted after the collection named in insert_after. Run scripts/build-private.py after editing this file or layers-input.json.",
    "mcp_servers": [
        {
            "url": "https://duckdb-mcp.nrp-nautilus.io/mcp",
