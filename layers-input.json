                    "outline_style": {
                        "line-color": "#1565C0",
                        "line-width": 0.5
                    },
                    "tooltip_fields": ["name", "mrgid", "area_km2"]
                }
            ]
        },
        {
            "collection_id": "wdpa-december-2025",
            "assets": [
                {
                    "id": "wdpa-pmtiles",
                    "alias": "wdpa-marine",
                    "display_name": "Marine Protected Areas",
                    "group": "Protected Areas",
                    "visible": true,
                    "default_style": {
                        "fill-color": [
                            "match",
                            ["get", "IUCN_CAT"],
                            "Ia", "#0D47A1",
                            "Ib", "#1565C0",
                            "II", "#1976D2",
                            "III", "#1E88E5",
                            "IV", "#42A5F5",
                            "V", "#64B5F6",
                            "VI", "#90CAF9",
                            "#B0BEC5"
                        ],
                        "fill-opacity": 0.6
                    },
                    "default_filter": [
                        "match",
                        ["get", "REALM"],
                        ["Marine", "Coastal"],
                        true,
                        false
                    ],
                    "tooltip_fields": [
                        "NAME_ENG",
                        "DESIG_ENG",
                        "IUCN_CAT",
                        "NO_TAKE",
                        "GIS_M_AREA",
                        "STATUS"
                    ]
                }
            ]
