{
    "catalog": "https://s3-west.nrp-nautilus.io/public-data/stac/catalog.json",
    "titiler_url": "https://titiler.nrp-nautilus.io",
    "mcp_url": "https://duckdb-mcp.nrp-nautilus.io/mcp",
    "view": {
        "center": [0, 0],
        "zoom": 2.5
    },
    "default_basemap": "natgeo",
    "custom_basemap": {
        "url": "https://services.arcgisonline.com/ArcGIS/rest/services/Ocean/World_Ocean_Base/MapServer/tile/{z}/{y}/{x}",
        "label": "Ocean"
    },
    "llm": {
        "user_provided": true,
        "default_endpoint": "https://openrouter.ai/api/v1",
        "models": [
            {
                "value": "qwen/qwen3-235b-a22b",
                "label": "Qwen3 235B"
            },
            {
                "value": "moonshotai/kimi-k2",
                "label": "Kimi K2"
            },
            {
                "value": "minimax/minimax-m1",
                "label": "MiniMax M1"
            },
            {
                "value": "anthropic/claude-sonnet-4",
                "label": "Claude Sonnet"
            },
            {
                "value": "google/gemini-2.5-flash",
                "label": "Gemini Flash"
            }
        ]
    },
    "links": {
        "github": "https://github.com/boettiger-lab/bosl-high-seas",
        "carbon": true
    },
    "welcome": {
        "message": "Hi! I can help you explore high seas MPA candidates, seafloor geomorphology, and fishing effort data. Try asking:",
        "examples": [
            "What is the combined area of all high seas MPA candidates? Which candidates fall within the South Atlantic?",
            "How does 2024 fishing effort vary across different seafloor geomorphological features?",
            "If all high seas MPA candidates were implemented, how many hours of 2024 fishing effort would fall within their boundaries?",
            "What are the dominant seafloor geomorphological features within each MPA candidate?",
            "What percentage of global seamounts deeper than 1000m fall within the Salas y Gomez and Nazca Ridge MPA candidate?"
        ]
    },
    "collections": [
        {
            "collection_id": "gebco-2025",
            "collection_url": "https://s3-west.nrp-nautilus.io/public-high-seas/gebco-2025/stac-collection.json",
