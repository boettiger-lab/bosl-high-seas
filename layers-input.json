                    "id": "gebco-2025-cog",
                    "display_name": "Seafloor Bathymetry (GEBCO 2025)",
                    "group": "Seafloor",
                    "visible": false,
                    "colormap": "blues_r",
                    "rescale": "-6000,0",
                    "legend_label": "Depth (m)"
                }
            ]
        },
        {
