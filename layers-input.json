{
    "catalog": "https://s3-west.nrp-nautilus.io/public-data/stac/catalog.json",
    "titiler_url": "https://titiler.nrp-nautilus.io",
    "mcp_url": "https://duckdb-mcp.nrp-nautilus.io/mcp",
    "view": {
        "center": [0, 0],
        "zoom": 2.5,
        "globe": true
    },
    "draw_enabled": true,
    "auto_approve": true,
    "sidebar": {
        "enabled": true,
        "default_width": 460,
        "title": "High Seas Explorer",
        "chat_title": "Data Assistant"
    },
    "default_basemap": "natgeo",
    "custom_basemap": {
        "url": "https://services.arcgisonline.com/ArcGIS/rest/services/Ocean/World_Ocean_Base/MapServer/tile/{z}/{y}/{x}",
        "label": "Ocean"
    },
    "llm": {
        "user_provided": true,
        "default_endpoint": "https://openrouter.ai/api/v1",
        "models": [
            {
                "value": "qwen/qwen3-235b-a22b",
                "label": "Qwen3 235B"
            },
            {
                "value": "moonshotai/kimi-k2",
                "label": "Kimi K2"
            },
            {
                "value": "minimax/minimax-m1",
                "label": "MiniMax M1"
            },
            {
                "value": "anthropic/claude-sonnet-4",
                "label": "Claude Sonnet"
            },
            {
                "value": "google/gemini-2.5-flash",
                "label": "Gemini Flash"
            }
        ]
    },
    "links": {
        "github": "https://github.com/boettiger-lab/bosl-high-seas",
        "docs": "/docs.html",
        "carbon": true
    },
    "welcome": {
        "message": "Hi! I can help you explore marine protected areas, seafloor geomorphology, and fishing effort data. Try asking:",
        "examples": [
            "Fly to the Sargasso Sea",
            "How much and what kind of industrial fishing is there in the high seas in an area 200 nautical miles outside of the exclusive economic zone of Nigeria?",
            "How many seamounts are there in the Sargasso Sea \"Ecologically or Biologically Significant Marine Area\" that was designated on the high seas?"
        ]
    },
    "collections": [
        {
            "collection_id": "gfw-fishing-effort",
            "collection_url": "https://s3-west.nrp-nautilus.io/public-gfw/stac-collection.json",
            "group": "Fishing Effort",
            "assets": [
                {
                    "id": "fishing-effort-cog-2024",
                    "display_name": "Fishing Effort",
                    "visible": true,
                    "colormap": "reds",
                    "rescale": "0,200",
                    "legend_label": "Annual fishing hours",
                    "versions": [
                        { "label": "2024", "asset_id": "fishing-effort-cog-2024" },
                        { "label": "2023", "asset_id": "fishing-effort-cog-2023" },
                        { "label": "2022", "asset_id": "fishing-effort-cog-2022" },
                        { "label": "2021", "asset_id": "fishing-effort-cog-2021" },
                        { "label": "2020", "asset_id": "fishing-effort-cog-2020" },
                        { "label": "2019", "asset_id": "fishing-effort-cog-2019" },
                        { "label": "2018", "asset_id": "fishing-effort-cog-2018" },
                        { "label": "2017", "asset_id": "fishing-effort-cog-2017" },
                        { "label": "2016", "asset_id": "fishing-effort-cog-2016" },
                        { "label": "2015", "asset_id": "fishing-effort-cog-2015" },
                        { "label": "2014", "asset_id": "fishing-effort-cog-2014" },
                        { "label": "2013", "asset_id": "fishing-effort-cog-2013" },
                        { "label": "2012", "asset_id": "fishing-effort-cog-2012" }
                    ],
                    "default_version": "2024"
                }
            ]
        },
        {
            "collection_id": "iho-maritime-boundaries",
            "collection_url": "https://s3-west.nrp-nautilus.io/public-high-seas/iho/stac-collection.json",
            "assets": [
                {
                    "id": "eez-pmtiles",
                    "display_name": "Exclusive Economic Zones (EEZ)",
                    "group": "Maritime Boundaries",
                    "visible": false,
                    "default_style": {
                        "fill-color": "rgba(0,0,0,0)",
                        "fill-opacity": 0
                    },
                    "outline_style": {
                        "line-color": "#F57F17",
                        "line-width": 1
                    },
                    "tooltip_fields": ["GEONAME", "SOVEREIGN1", "ISO_SOV1", "TERRITORY1", "POL_TYPE", "AREA_KM2"]
                },
                {
                    "id": "high-seas-pmtiles",
                    "display_name": "High Seas (ABNJ)",
                    "group": "Maritime Boundaries",
                    "visible": true,
                    "default_style": {
                        "fill-color": "#1565C0",
                        "fill-opacity": 0.15
                    },
                    "outline_style": {
                        "line-color": "#1565C0",
                        "line-width": 0.5
                    },
                    "tooltip_fields": ["name", "mrgid", "area_km2"]
                }
            ]
        },
        {
            "collection_id": "wdpa",
            "collection_url": "https://s3-west.nrp-nautilus.io/public-wdpa/wdpa/stac-collection.json",
            "assets": [
                {
                    "id": "wdpa-pmtiles",
                    "alias": "wdpa-marine",
                    "display_name": "Marine Protected Areas",
                    "group": "Designated Areas",
                    "visible": true,
                    "default_style": {
                        "fill-color": [
                            "match",
                            ["get", "IUCN_CAT"],
                            "Ia", "#0D47A1",
                            "Ib", "#1565C0",
                            "II", "#1976D2",
                            "III", "#1E88E5",
                            "IV", "#42A5F5",
                            "V", "#64B5F6",
                            "VI", "#90CAF9",
                            "#B0BEC5"
                        ],
                        "fill-opacity": 0.6
                    },
                    "default_filter": [
                        "match",
                        ["get", "REALM"],
                        ["Marine", "Coastal"],
                        true,
                        false
                    ],
                    "tooltip_fields": [
                        "NAME_ENG",
                        "DESIG_ENG",
                        "IUCN_CAT",
                        "NO_TAKE",
                        "GIS_M_AREA",
                        "STATUS"
                    ]
                }
            ]
        },
        {
            "collection_id": "ebsa",
            "collection_url": "https://s3-west.nrp-nautilus.io/public-high-seas/ebsa/stac-collection.json",
            "assets": [
                {
                    "id": "ebsa-pmtiles",
                    "display_name": "Significant Marine Areas (EBSAs)",
