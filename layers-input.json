{
    "catalog": "https://s3-west.nrp-nautilus.io/public-data/stac/catalog.json",
    "titiler_url": "https://titiler.nrp-nautilus.io",
    "mcp_url": "https://duckdb-mcp.nrp-nautilus.io/mcp",
    "view": {
        "center": [0, 0],
        "zoom": 2
    },
    "default_basemap": "natgeo",
    "custom_basemap": {
        "url": "https://services.arcgisonline.com/ArcGIS/rest/services/Ocean/World_Ocean_Base/MapServer/tile/{z}/{y}/{x}",
        "label": "Ocean"
    },
    "llm": {
        "user_provided": true,
        "default_endpoint": "https://openrouter.ai/api/v1",
        "models": [
            {
                "value": "qwen/qwen3-235b-a22b",
                "label": "Qwen3 235B"
            },
            {
                "value": "moonshotai/kimi-k2",
                "label": "Kimi K2"
            },
            {
                "value": "minimax/minimax-m1",
                "label": "MiniMax M1"
            },
            {
                "value": "anthropic/claude-sonnet-4",
                "label": "Claude Sonnet"
            },
            {
                "value": "google/gemini-2.5-flash",
                "label": "Gemini Flash"
            }
        ]
    },
    "links": {
        "github": "https://github.com/boettiger-lab/bosl-high-seas",
        "carbon": true
    },
    "welcome": {
        "message": "Hi! I can help you explore high seas and marine protected area data. Try asking:",
        "examples": [
            "Tell me about the datasets you have access to.",
            "Show only marine protected areas on the map.",
            "Show me how fishing effort has changed from 2012 to 2024 by toggling the annual layers.",
            "Which IUCN protection categories have the most fishing activity inside their marine boundaries in 2024?"
        ]
    },
    "collections": [
        {
            "collection_id": "iho-maritime-boundaries",
            "collection_url": "https://s3-west.nrp-nautilus.io/public-high-seas/iho/stac-collection.json",
            "assets": [
                {
                    "id": "eez-pmtiles",
                    "display_name": "Exclusive Economic Zones (EEZ)",
                    "group": "Maritime Boundaries",
                    "visible": false,
                    "default_style": {
                        "fill-color": "rgba(0,0,0,0)",
                        "fill-opacity": 0
                    },
                    "outline_style": {
                        "line-color": "#F57F17",
                        "line-width": 1
                    },
                    "tooltip_fields": ["GEONAME", "SOVEREIGN1", "ISO_SOV1", "TERRITORY1", "POL_TYPE", "AREA_KM2"]
                },
                {
                    "id": "high-seas-pmtiles",
                    "display_name": "High Seas (ABNJ)",
                    "group": "Maritime Boundaries",
                    "visible": true,
                    "default_style": {
                        "fill-color": "#1565C0",
                        "fill-opacity": 0.15
                    },
                    "outline_style": {
                        "line-color": "#1565C0",
                        "line-width": 0.5
                    },
                    "tooltip_fields": ["name", "mrgid", "area_km2"]
                }
            ]
        },
        {
            "collection_id": "wdpa-december-2025",
            "assets": [
                {
                    "id": "wdpa-pmtiles",
                    "display_name": "All Protected Areas",
                    "group": "Protected Areas",
                    "visible": false,
                    "default_style": {
                        "fill-color": [
                            "match",
                            ["get", "REALM"],
                            "Marine", "#1565C0",
                            "Coastal", "#26A69A",
                            "Terrestrial", "#4CAF50",
                            "#888888"
                        ],
                        "fill-opacity": 0.5
                    },
                    "tooltip_fields": [
                        "NAME_ENG",
                        "DESIG_ENG",
                        "IUCN_CAT",
                        "REALM",
                        "GIS_AREA",
                        "STATUS"
                    ]
                },
                {
                    "id": "wdpa-pmtiles",
                    "alias": "wdpa-marine",
                    "display_name": "Marine Protected Areas",
                    "group": "Protected Areas",
                    "visible": true,
                    "default_style": {
                        "fill-color": [
                            "match",
                            ["get", "IUCN_CAT"],
                            "Ia", "#0D47A1",
                            "Ib", "#1565C0",
                            "II", "#1976D2",
                            "III", "#1E88E5",
                            "IV", "#42A5F5",
                            "V", "#64B5F6",
                            "VI", "#90CAF9",
                            "#B0BEC5"
                        ],
                        "fill-opacity": 0.6
                    },
                    "default_filter": [
                        "match",
                        ["get", "REALM"],
                        ["Marine", "Coastal"],
                        true,
                        false
                    ],
                    "tooltip_fields": [
                        "NAME_ENG",
                        "DESIG_ENG",
                        "IUCN_CAT",
                        "NO_TAKE",
                        "GIS_M_AREA",
                        "STATUS"
                    ]
                }
            ]
        },
